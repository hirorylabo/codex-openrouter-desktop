#!/usr/bin/env python3
"""codex-openrouter-doctor の入口。

検査ロジックは `codex_openrouter.doctor` にある。ここはテンプレート置換で
決まるパスを解決して委譲するだけの薄いshim。テンプレートに埋め込むと
CIから直接unittestできないため、v0.2.0でロジックをモジュールへ移した。
"""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

USER_HOME = Path("@@USER_HOME@@")
SUPPORT_ROOT = Path("@@USER_HOME@@/.local/share/codex-openrouter-desktop/current")

sys.path.insert(0, str(SUPPORT_ROOT / "src"))

from codex_openrouter.app import UserPaths  # noqa: E402
from codex_openrouter.doctor import run  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="codex-openrouter-doctor")
    parser.add_argument("--network", action="store_true")
    parser.add_argument("--runtime", action="store_true")
    parser.add_argument("--secret-scan", action="store_true")
    args = parser.parse_args()
    return run(
        UserPaths.current(),
        SUPPORT_ROOT / "models/registry.json",
        network=args.network,
        runtime=args.runtime,
        secret_scan=args.secret_scan,
    )


if __name__ == "__main__":
    raise SystemExit(main())
