#!@@PYTHON@@
"""Validate the isolated Codex OpenRouter Desktop installation."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import plistlib
import stat
import subprocess
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request


USER_HOME = Path("@@USER_HOME@@")
STOCK_APP = Path("/Applications/ChatGPT.app")
STOCK_HOME = USER_HOME / ".codex"
OPENROUTER_APP = Path(os.environ.get("CODEX_OPENROUTER_APP", USER_HOME / "Applications/ChatGPT OpenRouter.app"))
OPENROUTER_HOME = Path(os.environ.get("CODEX_OPENROUTER_HOME", USER_HOME / ".codex-openrouter"))
CONFIG = OPENROUTER_HOME / "config.toml"
CATALOG = OPENROUTER_HOME / "model-catalogs/openrouter.json"
DESKTOP_PROVIDERS = OPENROUTER_HOME / "desktop-model-providers.json"
PROFILE_PATH = OPENROUTER_HOME / "profile.json"
REGISTRY_PATH = OPENROUTER_HOME / "registry.json"
ADAPTER_PATH = OPENROUTER_HOME / "adapter.json"
CREDENTIAL = Path(
    os.environ.get(
        "CODEX_OPENROUTER_CREDENTIAL",
        USER_HOME / ".local/bin/codex-openrouter-credential",
    )
)
REFRESH_STATE = OPENROUTER_HOME / "price-refresh-state.json"
REFRESH = USER_HOME / ".local/bin/codex-openrouter-refresh"
LAUNCHER = USER_HOME / ".local/bin/codex-openrouter-app"
DOCTOR = USER_HOME / ".local/bin/codex-openrouter-doctor"
CODEX = OPENROUTER_APP / "Contents/Resources/codex"
STOCK_ASAR = STOCK_APP / "Contents/Resources/app.asar"
OPENROUTER_ASAR = OPENROUTER_APP / "Contents/Resources/app.asar"
ENDPOINT = "https://openrouter.ai/api/v1/responses"


class Doctor:
    def __init__(self) -> None:
        self.failures: list[str] = []

    def ok(self, message: str) -> None:
        print(f"OK: {message}")

    def fail(self, message: str) -> None:
        self.failures.append(message)
        print(f"FAIL: {message}")

    def expect(self, condition: bool, success: str, failure: str) -> None:
        self.ok(success) if condition else self.fail(failure)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def bundle_value(app: Path, key: str) -> str:
    with (app / "Contents/Info.plist").open("rb") as handle:
        return str(plistlib.load(handle)[key])


def mode(path: Path) -> int:
    return stat.S_IMODE(path.stat().st_mode)


def load_json(path: Path, doctor: Doctor) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        doctor.fail(f"{path.name}を読めません: {error}")
        return {}
    if not isinstance(value, dict):
        doctor.fail(f"{path.name}のトップレベルがobjectではありません")
        return {}
    return value


def credential() -> str:
    result = subprocess.run(
        [str(CREDENTIAL), "get"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0 or not result.stdout.startswith("sk-or-"):
        raise RuntimeError("macOS KeychainからOpenRouter API keyを取得できません")
    return result.stdout


def contracts(doctor: Doctor) -> tuple[dict, dict, tuple[str, ...]]:
    registry_document = load_json(REGISTRY_PATH, doctor)
    profile = load_json(PROFILE_PATH, doctor)
    registry = registry_document.get("models", {})
    models = profile.get("models", [])
    if (
        registry_document.get("schema_version") != 1
        or profile.get("schema_version") != 1
        or not isinstance(registry, dict)
        or not isinstance(models, list)
        or not models
        or len(models) != len(set(models))
        or not set(models).issubset(registry)
        or profile.get("default_model") not in models
    ):
        doctor.fail("registry/profile contractが不正です")
        return {}, {}, ()
    return profile, registry, tuple(models)


def expected_user_data(adapter: dict) -> Path:
    override = os.environ.get("CODEX_OPENROUTER_USER_DATA")
    if override:
        return Path(override)
    adapter_id = str(adapter.get("id", ""))
    if not adapter_id or any(char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for char in adapter_id):
        raise ValueError("adapter id cannot be used as a userData directory")
    return OPENROUTER_HOME / "user-data" / adapter_id


def check_stock_and_clone(doctor: Doctor, adapter: dict) -> None:
    required = (STOCK_APP, STOCK_ASAR, OPENROUTER_APP, OPENROUTER_ASAR)
    if not all(path.exists() for path in required):
        doctor.fail("stockまたはOpenRouter appが見つかりません")
        return
    version = str(adapter.get("chatgpt_version", ""))
    build = str(adapter.get("chatgpt_build", ""))
    stock_hash = str(adapter.get("stock_asar_sha256", ""))
    patched_hash = str(adapter.get("patched_asar_sha256", ""))
    marker = str(adapter.get("marker", "")).encode("utf-8")
    doctor.expect(
        bundle_value(STOCK_APP, "CFBundleShortVersionString") == version
        and bundle_value(STOCK_APP, "CFBundleVersion") == build
        and sha256(STOCK_ASAR) == stock_hash,
        "stock appはadapterのversion/build/hashと一致し変更されていません",
        "stock appがadapterのbaselineと一致しません",
    )
    stock_signature = subprocess.run(
        ["/usr/bin/codesign", "--verify", "--deep", "--strict", str(STOCK_APP)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    doctor.expect(
        stock_signature.returncode == 0,
        "stock appの署名は有効です",
        "stock appの署名検証に失敗しました",
    )
    doctor.expect(
        bundle_value(OPENROUTER_APP, "CFBundleShortVersionString") == version
        and bundle_value(OPENROUTER_APP, "CFBundleVersion") == build,
        "OpenRouter cloneのversion/buildがbaselineと一致します",
        "OpenRouter cloneのversion/buildが一致しません",
    )
    doctor.expect(
        bool(patched_hash) and sha256(OPENROUTER_ASAR) == patched_hash,
        "OpenRouter ASARはadapterの検証済みhashと一致します",
        "OpenRouter ASAR hashがadapterと一致しません",
    )
    asar_bytes = OPENROUTER_ASAR.read_bytes()
    doctor.expect(
        bool(marker) and asar_bytes.count(marker) == 1,
        "OpenRouter ASARにpatch markerが1件あります",
        "patch markerが欠落または重複しています",
    )
    if adapter.get("patch_strategy") == "exact":
        doctor.expect(
            asar_bytes.count(b"i&&t===`amazonBedrock`?n.has(r.model):!r.hidden") == 1,
            "既知adapterのdynamic model filterが1件あります",
            "既知adapterのdynamic model filterが不正です",
        )
    signature = subprocess.run(
        ["/usr/bin/codesign", "--verify", "--deep", "--strict", str(OPENROUTER_APP)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    doctor.expect(
        signature.returncode == 0,
        "OpenRouter cloneの署名を検証しました",
        "OpenRouter cloneの署名検証に失敗しました",
    )


def check_config_and_catalog(
    doctor: Doctor, profile: dict, registry: dict, expected_models: tuple[str, ...]
) -> None:
    try:
        with CONFIG.open("rb") as handle:
            config = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        doctor.fail(f"config.tomlを読めません: {error}")
        return
    selected = config.get("model")
    contract = registry.get(selected, {})
    efforts = contract.get("efforts", [])
    selected_effort = config.get("model_reasoning_effort")
    effort_ok = selected_effort in efforts if efforts else selected_effort is None
    doctor.expect(
        selected == profile.get("default_model")
        and config.get("model_provider") == "openrouter"
        and effort_ok
        and config.get("model_catalog_json") == str(CATALOG),
        "configはprofileの既定モデルとOpenRouter providerを選択しています",
        "configのmodel/provider/reasoning/catalog契約が不正です",
    )
    try:
        catalog = json.loads(CATALOG.read_text(encoding="utf-8"))
        models = catalog.get("models", [])
    except (OSError, json.JSONDecodeError) as error:
        doctor.fail(f"catalogを読めません: {error}")
        return
    slugs = [model.get("slug") for model in models if isinstance(model, dict)]
    doctor.expect(
        len(models) == len(expected_models)
        and len(slugs) == len(set(slugs))
        and set(slugs) == set(expected_models),
        "catalogのslug集合はprofileと完全一致します",
        f"catalog slugがprofileと一致しません: {slugs}",
    )
    descriptors_ok = True
    for model in models:
        slug = model.get("slug")
        item = registry.get(slug, {})
        levels = [level.get("effort") for level in model.get("supported_reasoning_levels", [])]
        if any(
            (
                model.get("display_name") != item.get("display_name"),
                item.get("canonical_slug") not in str(model.get("description", "")),
                "通常headline:" not in str(model.get("description", "")),
                "ZDR稼働endpoint最安:" not in str(model.get("description", "")),
                "CACHE_READ" not in str(model.get("description", "")),
                model.get("default_reasoning_level") != item.get("default_effort"),
                levels != item.get("efforts"),
                model.get("input_modalities") != item.get("codex_modalities"),
                model.get("context_window") != item.get("context_window"),
                model.get("supports_parallel_tool_calls")
                != item.get("supports_parallel_tool_calls"),
            )
        ):
            descriptors_ok = False
            break
    doctor.expect(
        descriptors_ok,
        "catalog descriptorはregistryのmodel契約と一致します",
        "catalog descriptorがregistryと一致しません",
    )
    providers = load_json(DESKTOP_PROVIDERS, doctor)
    mapping = providers.get("model_providers", {})
    doctor.expect(
        providers.get("default_provider") == "openrouter"
        and isinstance(mapping, dict)
        and set(mapping) == set(expected_models)
        and set(mapping.values()) == {"openrouter"},
        "Desktop provider mappingはprofileと完全一致します",
        "Desktop provider mappingがprofileと一致しません",
    )
    for path in (CONFIG, CATALOG, DESKTOP_PROVIDERS, PROFILE_PATH, REGISTRY_PATH, ADAPTER_PATH):
        doctor.expect(
            path.is_file() and not path.is_symlink() and mode(path) == 0o600,
            f"{path.name}はmode 600です",
            f"{path}が欠落またはmode 600ではありません",
        )
    if REFRESH_STATE.exists():
        state = load_json(REFRESH_STATE, doctor)
        refresh_contract = load_json(REGISTRY_PATH, doctor).get("price_refresh", {})
        valid_results = refresh_contract.get("state_results", [])
        doctor.expect(
            mode(REFRESH_STATE) == 0o600
            and state.get("schema") == refresh_contract.get("state_schema")
            and state.get("last_result") in valid_results
            and isinstance(state.get("last_attempt_epoch"), int)
            and state.get("last_attempt_epoch", 0) <= int(time.time()) + 300,
            "price refresh stateは有効です",
            "price refresh stateが不正です",
        )
    for path in (CREDENTIAL, REFRESH, LAUNCHER, DOCTOR):
        doctor.expect(
            path.is_file() and not path.is_symlink() and mode(path) == 0o755,
            f"{path.name}はmode 755です",
            f"{path}が欠落またはmode 755ではありません",
        )


def check_app_server(doctor: Doctor, expected_models: tuple[str, ...]) -> None:
    environment = os.environ.copy()
    environment["CODEX_HOME"] = str(OPENROUTER_HOME)
    result = subprocess.run(
        [str(CODEX), "debug", "models"],
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        doctor.fail("bundled Codexがcatalogを読み込めません")
        return
    try:
        models = json.loads(result.stdout).get("models", [])
    except json.JSONDecodeError:
        doctor.fail("bundled Codexのmodel JSONが不正です")
        return
    slugs = [model.get("slug") for model in models if isinstance(model, dict)]
    doctor.expect(
        len(slugs) == len(expected_models) and set(slugs) == set(expected_models),
        "App Server model listはprofileと完全一致します",
        f"App Server model listが不正です: {slugs}",
    )


def request_model(key: str, model: str, effort: str | None) -> tuple[int, dict, str | None]:
    body = {
        "model": model,
        "input": "Return exactly OK.",
        "max_output_tokens": 64,
        "provider": {"zdr": True},
    }
    if effort is not None:
        body["reasoning"] = {"effort": effort}
    request = urllib.request.Request(
        ENDPOINT,
        data=json.dumps(body).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "X-OpenRouter-Metadata": "enabled",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            return response.status, json.load(response), response.headers.get("X-Generation-Id")
    except urllib.error.HTTPError as error:
        try:
            return error.code, json.loads(error.read()), error.headers.get("X-Generation-Id")
        except json.JSONDecodeError:
            return error.code, {}, error.headers.get("X-Generation-Id")


def authenticated_json(url: str, key: str) -> dict:
    request = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        payload = json.load(response)
    if not isinstance(payload, dict):
        raise ValueError("OpenRouter API returned a non-object payload")
    return payload


def generation_metadata(key: str, generation_id: str) -> dict:
    url = "https://openrouter.ai/api/v1/generation?id=" + urllib.parse.quote(generation_id)
    last: dict = {}
    for _attempt in range(5):
        last = authenticated_json(url, key).get("data", {})
        if isinstance(last, dict) and last.get("provider_name"):
            return last
        time.sleep(1)
    return last if isinstance(last, dict) else {}


def check_network(doctor: Doctor, registry: dict, expected_models: tuple[str, ...]) -> None:
    try:
        key = credential()
        available_data = authenticated_json(
            "https://openrouter.ai/api/v1/models/user", key
        ).get("data", [])
        zdr_data = authenticated_json(
            "https://openrouter.ai/api/v1/endpoints/zdr", key
        ).get("data", [])
        zdr_providers = {
            model: {
                endpoint.get("provider_name")
                for endpoint in zdr_data
                if isinstance(endpoint, dict)
                and endpoint.get("model_id") == model
                and endpoint.get("status") == 0
                and isinstance(endpoint.get("provider_name"), str)
            }
            for model in expected_models
        }
        model_ids = {
            item.get("id")
            for item in available_data
            if isinstance(item, dict)
            and isinstance(item.get("id"), str)
        }
        concrete = {
            model
            for model in model_ids
            if not model.startswith("openrouter/") and not model.startswith("~")
        }
        doctor.expect(
            concrete == set(expected_models)
            and not any(model.startswith("qwen/") or model.startswith("~qwen/") for model in model_ids),
            "OpenRouter keyの実効model集合はprofileと完全一致します",
            f"OpenRouter keyの実効model集合が不正です: {sorted(concrete)}",
        )
        for model in expected_models:
            efforts = registry[model].get("efforts") or [None]
            for effort in efforts:
                status, body, generation_id = request_model(key, model, effort)
                actual_model = body.get("model")
                metadata = (
                    generation_metadata(key, generation_id)
                    if isinstance(generation_id, str) and generation_id
                    else {}
                )
                actual_provider = metadata.get("provider_name")
                doctor.expect(
                    200 <= status < 300
                    and actual_model == model
                    and isinstance(actual_provider, str)
                    and actual_provider in zdr_providers.get(model, set()),
                    f"ZDR canaryは{model} ({effort or 'provider-controlled'})を実providerで完了しました",
                    f"ZDR canary失敗: {model} ({effort or 'provider-controlled'}, HTTP {status})",
                )
        negative_model = str(load_json(REGISTRY_PATH, doctor).get("negative_model", ""))
        status, negative_body, _generation_id = request_model(key, negative_model, None)
        error = negative_body.get("error", {})
        error_message = str(error.get("message", "") if isinstance(error, dict) else error).lower()
        doctor.expect(
            status in {400, 403, 404}
            and any(
                token in error_message
                for token in ("guardrail", "data policy", "zdr", "provider", "allowlist", "not allowed")
            ),
            "profile外modelのnegative canaryは拒否されました",
            f"profile外modelが拒否されませんでした: HTTP {status}",
        )
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError, urllib.error.URLError) as error:
        doctor.fail(f"OpenRouter network canary失敗: {type(error).__name__}: {error}")


def check_runtime(doctor: Doctor, adapter: dict) -> None:
    result = subprocess.run(
        ["/bin/ps", "-axo", "pid=,command="],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        doctor.fail("process listを取得できません")
        return
    clone = [line for line in result.stdout.splitlines() if f"{OPENROUTER_APP}/Contents/MacOS/ChatGPT" in line]
    doctor.expect(
        len(clone) == 1,
        "OpenRouter main processが1件起動しています",
        f"OpenRouter main processは{len(clone)}件です",
    )
    try:
        user_data = expected_user_data(adapter)
    except ValueError as error:
        doctor.fail(str(error))
        return
    doctor.expect(
        len(clone) == 1 and f"--user-data-dir={user_data}" in clone[0],
        "OpenRouter processは専用Electron userDataを使用しています",
        "OpenRouter processのElectron userDataが不正です",
    )
    key = credential()
    doctor.expect(
        key not in result.stdout,
        "API keyはprocess argumentsにありません",
        "API keyがprocess argumentsに露出しています",
    )


def check_secret_scan(doctor: Doctor, adapter: dict) -> None:
    key = credential()
    needle = key.encode("utf-8")
    candidates = [
        CONFIG, CATALOG, DESKTOP_PROVIDERS, PROFILE_PATH, REGISTRY_PATH,
        ADAPTER_PATH, REFRESH, LAUNCHER, DOCTOR,
    ]
    try:
        user_data = expected_user_data(adapter)
    except ValueError as error:
        doctor.fail(str(error))
        return
    for root in (OPENROUTER_HOME / "logs", user_data):
        if not root.is_dir():
            continue
        for path in root.rglob("*"):
            try:
                if path.is_file() and path.stat().st_size <= 32 * 1024 * 1024:
                    candidates.append(path)
            except OSError:
                continue
    exposed = []
    for path in candidates:
        try:
            if needle in path.read_bytes():
                exposed.append(str(path))
        except OSError:
            continue
    doctor.expect(
        not exposed,
        "API key実値はconfig、script、log、userDataに残っていません",
        f"API key実値が残っています: {exposed}",
    )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--network", action="store_true")
    parser.add_argument("--runtime", action="store_true")
    parser.add_argument("--secret-scan", action="store_true")
    args = parser.parse_args()
    doctor = Doctor()
    adapter = load_json(ADAPTER_PATH, doctor)
    profile, registry, expected_models = contracts(doctor)
    if adapter and expected_models:
        check_stock_and_clone(doctor, adapter)
        check_config_and_catalog(doctor, profile, registry, expected_models)
        check_app_server(doctor, expected_models)
        if args.network:
            print("INFO: --networkは少量のOpenRouter API利用料が発生する場合があります")
            check_network(doctor, registry, expected_models)
        if args.runtime:
            check_runtime(doctor, adapter)
        if args.secret_scan:
            check_secret_scan(doctor, adapter)
    if doctor.failures:
        print(f"RESULT: FAIL ({len(doctor.failures)} finding(s))")
        return 1
    print("RESULT: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
