#!/bin/zsh
set -eu
setopt pipefail

# 案D: 純正 /Applications/ChatGPT.app は一切変更しない。
# ASAR hash・patch marker・専用appの署名検証は不要になったので持たない。
# ここは事前処理と後始末を supervisor へ渡すだけの薄い入口。

readonly STOCK_APP="/Applications/ChatGPT.app"
readonly STATE_DIR="@@USER_HOME@@/.local/share/codex-openrouter-desktop/state"
readonly LOG_DIR="$STATE_DIR/logs"
readonly LAUNCHER_LOG="$LOG_DIR/launcher.log"
readonly PYTHON="@@PYTHON@@"
readonly SUPPORT_ROOT="@@USER_HOME@@/.local/share/codex-openrouter-desktop/current"
readonly CREDENTIAL="@@USER_HOME@@/.local/bin/codex-openrouter-credential"
readonly MAX_LOG_BYTES=$((10 * 1024 * 1024))

fail() {
  print -u2 -- "Codex OpenRouter: $*"
  [[ ! -d "$LOG_DIR" ]] || print -- "$(/bin/date '+%Y-%m-%dT%H:%M:%S%z') FAIL $*" >> "$LAUNCHER_LOG"
  exit 1
}

rotate_log() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  local size="$(/usr/bin/stat -f %z "$path" 2>/dev/null || print 0)"
  [[ "$size" == <-> && "$size" -ge "$MAX_LOG_BYTES" ]] || return 0
  [[ ! -f "$path.1" ]] || /bin/mv -f "$path.1" "$path.2"
  /bin/mv -f "$path" "$path.1"
}

[[ -x "$PYTHON" ]] || fail "python3がありません。codex-openrouter setupを再実行してください。"
[[ -d "$SUPPORT_ROOT/src" ]] || fail "runtimeがありません。codex-openrouter setupを再実行してください。"
[[ -d "$STOCK_APP" ]] || fail "公式ChatGPT.appがありません: $STOCK_APP"
[[ -x "$CREDENTIAL" ]] || fail "Keychain helperがありません。codex-openrouter setupを再実行してください。"

workspace="${1:-$PWD}"
[[ -d "$workspace" ]] || fail "workspaceはディレクトリを指定してください: $workspace"
[[ "$workspace" == /* ]] || workspace="$PWD/$workspace"

/bin/mkdir -p "$LOG_DIR"
/bin/chmod 700 "$STATE_DIR" "$LOG_DIR"
rotate_log "$LAUNCHER_LOG"
(umask 077 && : >> "$LAUNCHER_LOG")
/bin/chmod 600 "$LAUNCHER_LOG"

# 鍵はKeychain helper経由でのみ渡る。shellのsecretは継がせない。
unset OPENROUTER_API_KEY CODEX_ACCESS_TOKEN

# 導入元に差分があればここで反映する。端末でupgradeを打たなくて済むように。
# 失敗しても起動は止めない(自動rollback済みの状態で続行する)。
/usr/bin/env PYTHONUNBUFFERED=1 "$PYTHON" "$SUPPORT_ROOT/codex-openrouter" \
  upgrade --if-needed 2>&1 | /usr/bin/tee -a "$LAUNCHER_LOG" || true

# supervisor が [1]self-heal [2]排他 [3]update追従 [4]port [5]config
# [6]guard/watcher [7]純正app起動 [8]後始末 まで面倒を見る。
# PYTHONUNBUFFERED: pipe越しだとblock bufferingされ、セッション終了まで
# ログが空のままになる。ランチャーのHUDも行が届かないと出せない。
exec /usr/bin/env PYTHONPATH="$SUPPORT_ROOT/src" PYTHONUNBUFFERED=1 \
  "$PYTHON" -m codex_openrouter.cli launch "$workspace" 2>&1 | /usr/bin/tee -a "$LAUNCHER_LOG"
