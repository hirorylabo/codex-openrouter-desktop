#!/usr/bin/env python3
"""Repository and installed entry point for Codex OpenRouter Desktop."""

from __future__ import annotations

import os
from pathlib import Path
import sys


if sys.version_info < (3, 11):
    raise SystemExit(
        "codex-openrouter: Python 3.11以上が必要です。"
        f"現在は {sys.version_info.major}.{sys.version_info.minor} です"
    )


def source_root() -> Path:
    adjacent = Path(__file__).resolve().parent
    if (adjacent / "src/codex_openrouter").is_dir():
        return adjacent
    installed = Path.home() / ".local/share/codex-openrouter-desktop/current"
    if (installed / "src/codex_openrouter").is_dir():
        return installed
    raise SystemExit("codex-openrouter: runtime source treeが見つかりません")


ROOT = source_root()
os.environ["CODEX_OPENROUTER_SOURCE_ROOT"] = str(ROOT)
sys.path.insert(0, str(ROOT / "src"))

from codex_openrouter.cli import main


raise SystemExit(main())
